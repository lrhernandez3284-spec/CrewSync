<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Task title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <AutoCompleteTextView
            android:id="@+id/etCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Category"
            android:completionThreshold="0"
            android:inputType="textCapWords"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/etTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvAssign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Assign users:"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <CheckBox
            android:id="@+id/cbSelectAllUsers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Select all users"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvAssign"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ListView
            android:id="@+id/listUsers"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:choiceMode="multipleChoice"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/cbSelectAllUsers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvDue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Due: (tap Set Due Date)"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/listUsers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnPickDue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Set Due Date/Time"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvDue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnSaveTask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnPickDue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
