<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/taskRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_surface_card"
    android:padding="14dp">

    <CheckBox
        android:id="@+id/cbDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:buttonTint="@color/accent_cyan"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTaskTitle"
        style="@style/CrewSync.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Task title"
        android:textStyle="bold"
        android:textSize="17sp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/cbDone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnEdit"/>

    <TextView
        android:id="@+id/tvTaskMeta"
        style="@style/CrewSync.Text.Meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Category • Due"
        android:layout_marginTop="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/cbDone"
        app:layout_constraintTop_toBottomOf="@id/tvTaskTitle"
        app:layout_constraintEnd_toStartOf="@id/btnEdit"/>

    <Button
        android:id="@+id/btnEdit"
        style="@style/Widget.CrewSync.Button.Secondary"
        android:layout_width="76dp"
        android:layout_height="44dp"
        android:text="Edit"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnDelete"/>

    <Button
        android:id="@+id/btnDelete"
        style="@style/Widget.CrewSync.Button.Secondary"
        android:layout_width="86dp"
        android:layout_height="44dp"
        android:text="Delete"
        android:textSize="13sp"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
