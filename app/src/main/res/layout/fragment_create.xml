<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvBrand"
        style="@style/CrewSync.Text.Brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="CrewSync"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCreateTitle"
        style="@style/CrewSync.Text.ScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPickEvent"
        style="@style/CrewSync.Text.Meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select event for task:"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvCreateTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Spinner
        android:id="@+id/spEvent"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_surface"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvPickEvent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnCreateTask"
        style="@style/CrewSync.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create Task"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/spEvent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnCreateEvent"
        style="@style/CrewSync.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create Event"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnCreateTask"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
