<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_event_card"
    android:padding="16dp">

    <View
        android:id="@+id/vCategoryBar"
        android:layout_width="7dp"
        android:layout_height="0dp"
        android:background="@color/neon_purple"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvEventTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Event Title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@id/vCategoryBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/vCategoryDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@color/neon_cyan"
        android:layout_marginStart="14dp"
        app:layout_constraintStart_toEndOf="@id/vCategoryBar"
        app:layout_constraintTop_toTopOf="@id/tvEventMeta"
        app:layout_constraintBottom_toBottomOf="@id/tvEventMeta"/>

    <TextView
        android:id="@+id/tvEventMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Category • Date/Time • Upcoming"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@id/vCategoryDot"
        app:layout_constraintTop_toBottomOf="@id/tvEventTitle"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvEventLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@id/tvEventMeta"
        app:layout_constraintTop_toBottomOf="@id/tvEventMeta"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvEventStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Event: Upcoming"
        android:textColor="@color/neon_cyan"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_event_status_pill"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@id/tvEventMeta"
        app:layout_constraintTop_toBottomOf="@id/tvEventLocation"/>

    <TextView
        android:id="@+id/tvEventProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tasks: —"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/tvEventMeta"
        app:layout_constraintTop_toBottomOf="@id/tvEventStatus"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnHideEvent"
        style="@style/Widget.CrewSync.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:text="Remove from dashboard"
        android:textSize="13sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvEventProgress"
        app:layout_constraintStart_toStartOf="@id/tvEventMeta"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
