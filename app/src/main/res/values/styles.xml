<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CrewSync">
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CrewSync.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CrewSync.Text.Brand" parent="CrewSync.Text">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_cyan</item>
    </style>

    <style name="CrewSync.Text.ScreenTitle" parent="CrewSync.Text">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CrewSync.Text.SectionTitle" parent="CrewSync.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CrewSync.Text.Body" parent="CrewSync.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CrewSync.Text.Meta" parent="CrewSync.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="CrewSync.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>

    <style name="CrewSync.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>

    <!-- Compatibility with earlier XML that uses Widget.CrewSync.* -->
    <style name="Widget.CrewSync.Button" parent="CrewSync.Button" />

    <style name="Widget.CrewSync.Button.Primary" parent="CrewSync.Button.Primary" />

    <style name="Widget.CrewSync.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>

</resources>
